# PostgreSQL (Neon recommended) — use the POOLED connection string for the API.
# connection_limit caps Prisma's pool; pgbouncer=true disables prepared statements
# that PgBouncer cannot guarantee across transactions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/landconnect?sslmode=require&pgbouncer=true&connection_limit=5"
# Direct (non-pooled) URL for migrations, optional
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/landconnect?sslmode=require"

# Auth — short-lived access token + rotating refresh token
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Server
PORT=4000
CORS_ORIGIN="*"
# Ping Neon before its ~5-minute idle suspend. 0 disables the keep-warm timer.
DB_KEEPWARM_MS=240000

# LiveKit (optional). Leave blank to use Socket.IO peer-to-peer signalling only.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Neon Object Storage (optional; needed for photo uploads). Generate with:
#   neon deploy && neon env pull
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
NEON_STORAGE_BUCKET=uploads
