{
  "name": "landconnect",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "api": "pnpm --filter @landconnect/api dev",
    "mobile": "pnpm --filter @landconnect/mobile start",
    "db:generate": "pnpm --filter @landconnect/api db:generate",
    "db:push": "pnpm --filter @landconnect/api db:push",
    "db:migrate": "pnpm --filter @landconnect/api db:migrate",
    "db:seed": "pnpm --filter @landconnect/api db:seed",
    "db:studio": "pnpm --filter @landconnect/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
