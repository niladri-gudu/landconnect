{
  "expo": {
    "name": "LandConnect",
    "slug": "landconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "landconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.landconnect.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LandConnect uses your camera for video calls and for photos of land you list.",
        "NSMicrophoneUsageDescription": "LandConnect uses your microphone for audio and video calls."
      }
    },
    "android": {
      "package": "com.landconnect.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#075E54",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LandConnect uses your location to tag land listings and show nearby properties."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LandConnect needs access to your photos to attach images to land listings."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#075E54",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f8a428f0-087b-48b5-8806-047cef5712d4"
      }
    },
    "owner": "niladri_expo"
  }
}
