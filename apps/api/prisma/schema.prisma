generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  BROKER
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum MessageType {
  TEXT
  IMAGE
  CALL
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  REJECTED
  MISSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(BUYER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings       Listing[]                 @relation("OwnerListings")
  conversations  ConversationParticipant[]
  messages       Message[]
  initiatedCalls CallSession[]             @relation("InitiatorCalls")
  receivedCalls  CallSession[]             @relation("ReceiverCalls")
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Decimal       @db.Decimal(14, 2)
  areaAcres   Decimal       @db.Decimal(10, 2)
  address     String
  city        String
  state       String
  country     String        @default("India")
  latitude    Float
  longitude   Float
  images      String[]
  status      ListingStatus @default(ACTIVE)
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner         User           @relation("OwnerListings", fields: [ownerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([city])
  @@index([ownerId])
  @@index([price])
  @@index([status])
}

model Conversation {
  id            String   @id @default(uuid())
  listingId     String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  listing      Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  calls        CallSession[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  type           MessageType @default(TEXT)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CallSession {
  id             String     @id @default(uuid())
  conversationId String
  initiatorId    String
  receiverId     String
  kind           CallKind
  status         CallStatus @default(RINGING)
  roomName       String     @unique
  createdAt      DateTime   @default(now())
  startedAt      DateTime?
  endedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiator    User         @relation("InitiatorCalls", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceiverCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([receiverId, status])
}
